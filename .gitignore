# ---- macOS ----
.DS_Store

# ---- Secrets / credentials (NEVER commit) ----
# Pickled OAuth access_token + refresh_token
ok/auth_refresh

# ---- Runtime / ephemeral state ----
# herdr: pane & tab layout state, logs, sockets, plugin lock
herdr/session.json
herdr/sessions/
herdr/*.log
herdr/*.sock
herdr/.plugins.lock

# ---- Build output ----
# (sketchybar/.gitignore already covers helper/.build, helpers/**/bin, *.sock)

# Herdr app-generated runtime data
herdr/release-notes.json

# pi: secrets and runtime state (live config is ~/.pi/agent)
pi/auth.json
pi/models-store.json
pi/sessions/
pi/run-history.jsonl
pi/*.log
pi/catppuccin-tui-state.json
pi/skills/
pi/npm/node_modules/
